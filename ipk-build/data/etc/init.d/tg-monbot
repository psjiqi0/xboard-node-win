#!/bin/sh /etc/rc.common
# tg-monbot - Telegram 监控机器人
# OpenWrt init.d script
# 说明: 二进制放在 /tmp/tg-monbot (tmpfs, 重启丢失)。
#       若 /tmp/tg-monbot 不存在, 则尝试从 DL_URL 下载。
#       在 /etc/config/tg-monbot 中设置:
#         option dl_url 'https://example.com/tg-monbot-mipsle'

START=99
USE_PROCD=1

PROG=/tmp/tg-monbot
CONF=/etc/tg-monbot/config.json

dl_url() {
    local url
    config_load tg-monbot
    config_get url tg-monbot dl_url
    echo "$url"
}

ensure_binary() {
    [ -x "$PROG" ] && return 0
    local url="$(dl_url)"
    [ -n "$url" ] || {
        echo "tg-monbot: /tmp/tg-monbot 不存在且未配置 dl_url"
        return 1
    }
    echo "tg-monbot: 下载二进制 $url ..."
    if command -v curl >/dev/null 2>&1; then
        curl -skL -o "$PROG" "$url"
    else
        wget -q -O "$PROG" "$url"
    fi
    chmod +x "$PROG" && return 0
}

start_service() {
    [ -f "$CONF" ] || {
        echo "tg-monbot: 配置不存在 $CONF"
        return 1
    }
    ensure_binary || return 1

    procd_open_instance
    procd_set_param command "$PROG" -c "$CONF"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    procd_kill "$(basename "$PROG")" 2>/dev/null || true
}

reload_service() {
    stop
    start
}

service_triggers() {
    procd_add_reload_trigger "tg-monbot"
}
